{
  "name": "kit-u1-smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:links",
    "test:e2e": "playwright test",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
